// Fonts

$font-family-body = "Microsoft YaHei", monospace
$font-family-mono = "Microsoft YaHei", monospace

$font-size = 18px
$line-height = 1.725
$page-width = 0rem + (hexo-config("page_width") || 39)

// Logo
$logo-width = 14px + (hexo-config("logo.width") || 0)
$logo-height = 14px + (hexo-config("logo.height") || 0)
$logo-grayout = hexo-config("logo.grayout") || false
// Colors
$colors = hexo-config("colorscheme") || "dark"
